---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Atmosphere from '../components/Atmosphere.astro';
---
<Layout><Atmosphere/><main><section class="portrait-screen" id="home" aria-label="雨天人物主页">
    <header class="site-header"><div><p class="eyebrow">LITTLE LINKS / 我的导航</p><h1 id="title">雨间小屋<span aria-hidden="true">.</span></h1><p class="intro-description">一些常用的好去处。</p></div><div class="weather-controls"><button id="theme-button" aria-label="切换到夜间模式" aria-pressed="false" title="夜间模式"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5Z"/></svg></button><button data-open-music aria-label="打开雨天音乐" title="雨天音乐">♫</button><button id="rain-switch" aria-label="切换雨天动效" aria-pressed="true" title="雨天动效开关">☂</button></div></header>
    <div class="hero-heading"><p>RAINY LITTLE HOME</p><h2>听，雨落下的声音<span aria-hidden="true">。</span></h2><span class="hero-subtitle">在这里，放慢一点也没关系。</span></div>
    <div class="home-stage"><span class="portrait-aura" aria-hidden="true"></span><div class="mascot-wrap"><button class="mascot-button" id="mascot-button" aria-label="和洛茜互动，切换人物动作"><img width="720" height="720" fetchpriority="high" decoding="async" id="mascot" src="assets/rain-girl.webp" alt="洛茜的Q版形象：浅金发、金色眼睛、红色兽耳兜帽，撑着蓝色小雨伞"></button></div><button class="cg-postcard scattered-card postcard-splash" data-scene="0" aria-label="放大查看一起踩水花"><img width="360" height="240" loading="lazy" decoding="async" src="assets/rain-cg-splash-thumb.webp" alt="洛茜和蓝色鱼尾女孩踩水花"></button><button class="cg-postcard scattered-card postcard-umbrella" data-scene="1" aria-label="放大查看共撑一把伞"><img width="360" height="240" loading="lazy" decoding="async" src="assets/rain-cg-umbrella-thumb.webp" alt="洛茜和蓝色鱼尾女孩共撑雨伞"></button><button class="cg-postcard scattered-card postcard-boats" data-scene="2" aria-label="放大查看纸船漂呀漂"><img width="360" height="240" loading="lazy" decoding="async" src="assets/rain-cg-boats-thumb.webp" alt="洛茜和蓝色鱼尾女孩一起放纸船"></button><button class="cg-postcard scattered-card postcard-tea" data-scene="3" aria-label="放大查看窗边的热茶"><img width="360" height="240" loading="lazy" decoding="async" src="assets/rain-cg-thumb.webp" alt="洛茜在雨天窗边捧着热茶"></button></div>
    <div class="scroll-cue" aria-hidden="true"><span>下滑，去喜欢的地方</span><span class="scroll-chevron"></span></div>
  </section>
  <section class="navigation-screen" id="navigation" aria-labelledby="navigation-title"><div class="navigation-inner"><h2 class="navigation-title" id="navigation-title">我的导航<span aria-hidden="true"> ↗</span></h2><Navigation /><div class="nav-note"><span>和喜欢的世界保持联系 <span class="footer-heart">♡</span></span><span>RAINY DAY · <span>{new Date().getFullYear()}</span></span></div></div></section>
</main><div class="greeting" id="greeting" role="status" aria-live="polite"><img src="assets/rain-girl-avatar.webp" width="46" height="46" alt=""/><div><span class="greeting-name">洛茜的小声问候</span><span class="greeting-text"></span></div><span class="greeting-heart" aria-hidden="true">♡</span></div><dialog id="cg-dialog" aria-labelledby="cg-title"><div class="cg-dialog-header"><div><span>RAINY MOMENT</span><h2 id="cg-title">一起踩水花</h2></div><button id="close-cg" aria-label="关闭CG">×</button></div><img class="cg-full-image" decoding="async" alt="洛茜和蓝色鱼尾女孩在雨中开心地踩水花"><p class="cg-caption" id="cg-caption" role="status">啪嗒！把小水洼踩成快乐的形状。</p></dialog><script is:inline src="scripts/home.js" defer></script></Layout>