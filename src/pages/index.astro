---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Atmosphere from '../components/Atmosphere.astro';
import {cgScenes,characterPoses} from '../config/characters';
import CharacterGallery from '../components/CharacterGallery.astro';
---
<Layout><Atmosphere/><main><section class="portrait-screen" id="home" aria-label="雨天人物主页">
    <header class="site-header"><div><p class="eyebrow">LITTLE LINKS / 我的导航</p><h1 id="title">雨间小屋<span aria-hidden="true">.</span></h1><p class="intro-description">一些常用的好去处。</p></div><div class="weather-controls"><button id="theme-button" aria-label="切换到夜间模式" aria-pressed="false" title="夜间模式"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5Z"/></svg></button><button data-open-music aria-label="打开雨天音乐" title="雨天音乐">♫</button><button id="rain-switch" aria-label="切换雨天动效" aria-pressed="true" title="雨天动效开关">☂</button></div></header>
    <div class="hero-heading"><p>RAINY LITTLE HOME</p><h2>听，雨落下的声音<span aria-hidden="true">。</span></h2><span class="hero-subtitle">在这里，放慢一点也没关系。</span></div>
    <div class="home-stage"><span class="portrait-aura" aria-hidden="true"></span><div class="mascot-wrap"><button class="mascot-button" id="mascot-button" aria-label="和洛茜互动，切换人物动作"><picture><source id="mascot-source" type="image/avif" srcset="assets/rain-girl.avif"/><img width="720" height="720" fetchpriority="high" decoding="async" id="mascot" src="assets/rain-girl.png" alt="洛茜的Q版形象：浅金发、金色眼睛、红色兽耳兜帽，撑着蓝色小雨伞"></picture></button></div>{[0,4,5,6].map((sceneIndex,slot)=>{const scene=cgScenes[sceneIndex];return <button class={`cg-postcard scattered-card ${['postcard-splash','postcard-umbrella','postcard-boats','postcard-tea'][slot]}`} data-scene={sceneIndex} aria-label={`放大查看${scene.title}`}><picture><source type="image/avif" srcset={scene.thumb}/><img width="360" height="240" loading="lazy" decoding="async" src={scene.thumb.replace(/\.avif$/,'.png')} alt={scene.alt}/></picture></button>;})}</div>
    <a class="star-link" href="./particles.html" aria-label="去星雨洛茜玩一会儿"><span class="star-glyph" aria-hidden="true">✦</span>星雨洛茜<span class="star-sub"> · 和星光玩一会儿</span></a>
    <div class="scroll-cue" aria-hidden="true"><span>下滑，去喜欢的地方</span><span class="scroll-chevron"></span></div>
  </section>
  <section class="navigation-screen" id="navigation" aria-labelledby="navigation-title"><div class="navigation-inner"><h2 class="navigation-title" id="navigation-title">我的导航<span aria-hidden="true"> ↗</span></h2><Navigation /><div class="nav-note"><span>和喜欢的世界保持联系 <span class="footer-heart">♡</span></span><span>RAINY DAY · <span>{new Date().getFullYear()}</span></span></div></div></section>
</main><div class="greeting" id="greeting" role="status" aria-live="polite"><picture><source type="image/avif" srcset="assets/rain-girl-avatar.avif"/><img src="assets/rain-girl-avatar.png" width="46" height="46" alt=""/></picture><div><span class="greeting-name">洛茜的小声问候</span><span class="greeting-text"></span></div><span class="greeting-heart" aria-hidden="true">♡</span></div><CharacterGallery scenes={cgScenes}/><script is:inline type="application/json" id="character-config" set:html={JSON.stringify({poses:characterPoses,scenes:cgScenes})}/><script is:inline src="scripts/home.js" defer></script></Layout>