---
import { musicConfig } from '../config/music';
const track=musicConfig.local[0];
---
<button class="music-launcher" id="music-launcher" data-open-music aria-label="展开雨天音乐" aria-controls="music-panel" aria-expanded="false" title="展开雨天音乐">
  <span class="record-vinyl"><img id="music-launcher-cover" src={track.pic} width="36" height="36" alt="" decoding="async" referrerpolicy="no-referrer"/><span class="record-hole"></span></span>
  <span class="record-indicator" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 18V6l10-2v12M9 9l10-2"/><ellipse cx="6" cy="18" rx="3" ry="2"/><ellipse cx="16" cy="16" rx="3" ry="2"/></svg></span>
</button>
<section class="music-panel" id="music-panel" data-config={JSON.stringify(musicConfig)} hidden role="region" aria-label="雨天音乐播放器">
  <div class="music-panel-heading"><div><span>RAINY RADIO</span><strong>雨天音乐</strong></div><button id="music-close" aria-label="收起音乐播放器" title="收起播放器"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button></div>
  <div class="music-track"><span class="music-disc"><img id="music-cover" data-src={track.pic} alt="音乐封面" width="64" height="64" decoding="async" referrerpolicy="no-referrer"/></span><div><strong id="music-title">{track.name}</strong><span id="music-artist">{track.artist}</span></div></div>
  <select id="music-source" aria-label="选择音乐来源"><option value="local">小屋单曲 · 博客同款</option><option value="netease">网易云歌单</option></select>
  <div class="music-progress"><input id="music-progress" type="range" min="0" max="100" value="0" step="0.1" disabled aria-label="播放进度"/><div><span id="music-current">0:00</span><span id="music-duration">0:00</span></div></div>
  <div class="music-controls"><button id="music-prev" aria-label="上一首" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5v14M19 5 8 12l11 7Z"/></svg></button><button id="music-play" aria-label="播放音乐"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 11 7-11 7Z"/></svg></button><button id="music-next" aria-label="下一首" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 5v14M5 5l11 7-11 7Z"/></svg></button></div>
  <label class="music-volume"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4ZM15 8a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14"/></svg><input id="music-volume" type="range" min="0" max="100" step="1" value="55" aria-label="音量"/><span id="music-volume-value">55%</span></label>
  <p id="music-status" role="status">点一下播放，给小屋配一首歌。</p>
  <audio id="music-audio" preload="none"></audio>
</section>
