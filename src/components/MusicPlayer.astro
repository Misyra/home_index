---
import { musicConfig } from '../config/music';
const track=musicConfig.local[0];
---
<section class="music-panel" id="music-panel" data-config={JSON.stringify(musicConfig)} hidden role="region" aria-label="雨天音乐播放器">
  <div class="music-panel-heading"><span>雨天音乐</span><button id="music-close" aria-label="收起音乐播放器">×</button></div>
  <div class="music-track"><span class="music-disc"><img id="music-cover" data-src="assets/music-cover.webp" alt="音乐封面" width="56" height="56"/></span><div><strong id="music-title">{track.name}</strong><span id="music-artist">{track.artist}</span></div></div>
  <select id="music-source" aria-label="选择音乐来源"><option value="local">小屋单曲 · 博客同款</option><option value="netease">网易云歌单</option></select>
  <div class="music-progress"><input id="music-progress" type="range" min="0" max="100" value="0" step="0.1" disabled aria-label="播放进度"/><div><span id="music-current">0:00</span><span id="music-duration">0:00</span></div></div>
  <div class="music-controls"><button id="music-prev" aria-label="上一首" disabled>⏮</button><button id="music-play" aria-label="播放音乐">▶</button><button id="music-next" aria-label="下一首" disabled>⏭</button><label class="music-volume"><span>音量</span><input id="music-volume" type="range" min="0" max="100" step="1" value="55" aria-label="音量"/></label></div>
  <p id="music-status" role="status">点一下播放，给小屋配一首歌。</p>
  <audio id="music-audio" preload="none"></audio>
</section>
