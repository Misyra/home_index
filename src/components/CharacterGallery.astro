---
const {scenes}=Astro.props;
---
<dialog id="cg-dialog" aria-labelledby="cg-title">
  <div class="cg-dialog-header"><div><span>RAINY MOMENT</span><h2 id="cg-title">一起踩水花</h2></div><button id="close-cg" aria-label="关闭CG">×</button></div>
  <button class="cg-image-button" id="cg-image-next" aria-label="切换下一张CG" title="点击图片，切换下一张"><picture><source id="cg-source" type="image/avif" srcset=""/><img class="cg-full-image" decoding="async" alt=""/></picture></button>
  <div class="cg-dialogue"><picture><source type="image/avif" srcset="assets/rain-girl-avatar.avif"/><img src="assets/rain-girl-avatar.png" width="42" height="42" alt=""/></picture><div><span>洛茜的小声问候</span><p class="cg-caption" id="cg-caption" role="status" aria-live="polite"></p></div></div>
  <div class="cg-gallery-controls"><button class="cg-step" id="cg-prev" aria-label="上一张CG"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg></button><div class="cg-thumbnails" aria-label="选择雨天CG">{scenes.map((scene,index)=><button data-gallery-scene={index} aria-label={`查看${scene.title}`} aria-pressed="false"><picture><source type="image/avif" srcset={scene.thumb}/><img src={scene.thumb.replace(/\.avif$/,'.png')} alt="" width="66" height="44" loading="lazy" decoding="async"/></picture></button>)}</div><button class="cg-step" id="cg-next" aria-label="下一张CG"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></button></div>
  <div class="cg-gallery-note"><span id="cg-state" role="status">点击图片，看看下一刻。</span><span id="cg-counter">1 / {scenes.length}</span></div>
</dialog>
